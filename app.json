{
  "expo": {
    "name": "SSL School",
    "slug": "ssl-school",
    "scheme": "sslschool",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "school.ssl.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "school.ssl.mobile"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a payment receipt to submit to your school.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "acaa6b65-3d4a-43a2-8d0e-087779960ac1"
      }
    }
  }
}
