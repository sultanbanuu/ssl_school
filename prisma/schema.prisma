generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  manager
  teacher
  student
  @@map("position")
}

enum LessonStatus {
  scheduled
  completed
  cancelled
  rescheduled
}

enum PaymentStatus {
  pending
  approved
  cancelled
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  firstName     String?
  lastName      String?
  birthDate     String?
  learningTime  String?
  phone         String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  @@map("auth_users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  @@index([identifier])
  @@map("auth_verifications")
}

model Profile {
  id              String    @id @db.Uuid
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  phone           String?
  profilePhotoUrl String?   @map("profile_photo_url")
  role            Role      @default(student)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [id], references: [id], onDelete: Cascade)
  student         Student?
  teacher         Teacher?
  manager         Manager?
  admin           Admin?
  notifications   Notification[]
  reviewedPayments Payment[] @relation("PaymentReviewer")
  reviewedReschedules RescheduleRequest[] @relation("RescheduleReviewer")
  waivedReschedules RescheduleRequest[] @relation("RescheduleWaiver")
  @@map("profiles")
}

model Student {
  performanceLevel String? @map("performance_level")
  evaluations LessonEvaluation[]
  id           String    @id @default(uuid()) @db.Uuid
  profileId    String    @unique @map("profile_id") @db.Uuid
  englishLevel String?   @map("english_level")
  learningGoal String?   @map("learning_goal")
  status       String?   @default("active")
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]
  progress     ProgressRecord[]
  trialRequests TrialRequest[]
  rescheduleRequests RescheduleRequest[]
  payments     Payment[]
  paymentUploads PaymentUpload[]
  @@map("students")
}

model Teacher {
  performanceWeights Json? @map("performance_weights")
  evaluations LessonEvaluation[]
  id             String  @id @default(uuid()) @db.Uuid
  profileId      String  @unique @map("profile_id") @db.Uuid
  specialization String
  profile        Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  courses        Course[]
  enrollments    Enrollment[]
  availability AvailabilitySlot[]
  rescheduleRequests RescheduleRequest[]
  lessons        Lesson[]
  progress       ProgressRecord[]
  @@map("teachers")
}

model Manager {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @unique @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  @@map("manager")
}

model Admin {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @unique @map("profile_id") @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  @@map("admin")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  category    String
  description String?
  duration    BigInt?
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  teacherId   String   @map("teacher_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  availability AvailabilitySlot[]
  enrollments Enrollment[]
  payments    Payment[]
  paymentUploads PaymentUpload[]
  @@index([teacherId])
  @@map("courses")
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  lessons   Lesson[]
  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([teacherId])
  @@map("enrollments")
}

model Lesson {
  evaluations LessonEvaluation[]
  id           String       @id @default(uuid()) @db.Uuid
  enrollmentId String       @map("enrollment_id") @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  date         DateTime     @db.Date
  startTime    DateTime     @map("start_time") @db.Time(6)
  endTime      DateTime?    @map("end_time") @db.Time(6)
  endDate      DateTime?    @map("end_date") @db.Date
  allDay       Boolean      @default(false) @map("all_day")
  seriesId     String?      @map("series_id") @db.Uuid
  repeatRule   Json?        @map("repeat_rule")
    color        String?
  reminderMinutes Int?      @map("reminder_minutes")
  reminderAt   DateTime?    @map("reminder_at") @db.Timestamptz(6)
  reminderSentAt DateTime?  @map("reminder_sent_at") @db.Timestamptz(6)
  status       LessonStatus @default(scheduled)
  rescheduledAt DateTime? @map("rescheduled_at") @db.Timestamptz(6)
  cancelledByStudent Boolean @default(false) @map("cancelled_by_student")
  rescheduleRequests RescheduleRequest[]
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  progress     ProgressRecord[]
  @@index([enrollmentId])
  @@index([teacherId, date])
  @@index([seriesId, date])
  @@index([reminderAt, reminderSentAt])
  @@map("lessons")
}

model ProgressRecord {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  lessonId  String  @map("lesson_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  score     Decimal @db.Decimal(5, 2)
  comment   String?
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  @@index([studentId])
  @@index([lessonId])
  @@index([teacherId])
  @@map("progress_records")
}

model Payment {
  id         String  @id @default(uuid()) @db.Uuid
  studentId  String  @map("student_id") @db.Uuid
  courseId   String  @map("course_id") @db.Uuid
  amount     Decimal @db.Decimal(12, 2)
  status     PaymentStatus @default(pending)
  receiptUrl String? @map("reciept_url") // Legacy reference only; never exposed by the API.
  receiptKey String? @unique @map("receipt_key")
  uploadId String? @unique @map("upload_id") @db.Uuid
  upload PaymentUpload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  courseName String? @map("course_name")
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  startDate DateTime? @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewer Profile? @relation("PaymentReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  cancellationReason String? @map("cancellation_reason")
  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  @@index([studentId])
  @@index([courseId])
  @@index([studentId, submittedAt])
  @@index([status, submittedAt])
  @@map("payments")
}

model PaymentUpload {
  id String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  objectKey String @unique @map("object_key")
  contentType String @map("content_type")
  size Int
  amount Decimal @db.Decimal(12, 2)
  courseName String @map("course_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payment Payment?
  @@index([studentId, createdAt])
  @@map("payment_uploads")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  type      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AvailabilitySlot {
  id String @id @default(uuid()) @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  active Boolean @default(true)
  purpose String @default("trial")
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  requests TrialRequest[]
  rescheduleRequests RescheduleRequest[]
  @@index([teacherId, startsAt])
  @@index([startsAt])
  @@index([courseId])
  @@map("availability_slots")
}

model RescheduleRequest {
  id String @id @default(uuid()) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  slotId String? @map("slot_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  status String @default("pending")
  originalStart DateTime @map("original_start") @db.Timestamptz(6)
  originalEnd DateTime @map("original_end") @db.Timestamptz(6)
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewNote String? @map("review_note")
  quotaWaived Boolean @default(false) @map("quota_waived")
  waivedBy String? @map("waived_by") @db.Uuid
  waivedAt DateTime? @map("waived_at") @db.Timestamptz(6)
  waiverReason String? @map("waiver_reason")
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  slot AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  reviewer Profile? @relation("RescheduleReviewer", fields: [reviewedBy], references: [id], onDelete: NoAction)
  waiver Profile? @relation("RescheduleWaiver", fields: [waivedBy], references: [id], onDelete: NoAction)
  @@index([studentId, createdAt])
  @@index([teacherId, status])
  @@index([lessonId, status])
  @@map("reschedule_requests")
}

model TrialRequest {
  id String @id @default(uuid()) @db.Uuid
  slotId String @map("slot_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  status String @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  slot AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([slotId, studentId])
  @@index([studentId, status])
  @@index([slotId, status])
  @@map("trial_requests")
}

model LessonEvaluation {
  id String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  lessonId String @unique @map("lesson_id") @db.Uuid
  topic String
  assessment Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  @@index([studentId])
  @@index([teacherId])
  @@map("lesson_evaluations")
}
