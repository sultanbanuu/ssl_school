# A NEW development database. Do not point migrations at the Supabase draft.
DATABASE_URL=postgresql://school:school@localhost:5432/school
DIRECT_URL=postgresql://school:school@localhost:5432/school
# Generate locally: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:8081,sslschool://,ssl-school://
PORT=3000
NODE_ENV=development

# Private Cloudflare R2 bucket. Set all four to enable receipt uploads.
# R2_ACCOUNT_ID=your-32-character-account-id
# R2_ACCESS_KEY_ID=your-bucket-scoped-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET=ssl-school-receipts
