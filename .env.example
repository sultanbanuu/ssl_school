# A NEW development database. Do not point migrations at the Supabase draft.
# Runtime only; generate a separate password during db:setup-runtime.
DATABASE_URL=postgresql://school_app:replace-with-runtime-password@localhost:5432/school
# Put DIRECT_URL in .env.migrations (see .env.migrations.example), not in API secrets.
# Generate locally: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:8081,sslschool://
PORT=3000
NODE_ENV=development
# Public API address for the Expo app; use your computer's LAN address on a phone.
# Optional: native LAN development detects Expo's host on port 3000.
# EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_CURRENCY=AZN
# EAS project UUID for native push registration (or set expo.extra.eas.projectId).
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
# Optional server-only token when Expo enhanced push security is enabled.
# EXPO_ACCESS_TOKEN=your-expo-access-token

# Private Cloudflare R2 bucket. Set all four to enable receipt uploads.
# R2_ACCOUNT_ID=your-32-character-account-id
# R2_ACCESS_KEY_ID=your-bucket-scoped-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET=ssl-school-receipts
# Enable scheduled deletion only after reviewing `bun run receipts:cleanup`.
RECEIPT_CLEANUP_ENABLED=false
