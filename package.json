    "expo": "^58.0.14",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
