{
  "name": "ssl-school",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:school": "bun scripts/check-school-flow.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "account:create": "bun scripts/create-account.ts",
    "account:reset-password": "bun scripts/reset-password.ts",
    "mobile:start": "expo start",
    "mobile:web": "expo start --web",
    "test:notifications:ui": "bun scripts/test-notification-ui.ts",
    "test:calendar:ui": "bun scripts/test-calendar-ui.ts",
    "mobile:export": "expo export --platform web --output-dir mobile/dist-notification-review",
    "test:availability:ui": "bun scripts/test-availability-ui.ts",
    "test:performance:ui": "bun scripts/test-performance-ui.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@better-auth/expo": "1.7.10",
    "@elysiajs/cors": "1.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.10",
    "dotenv": "18.0.8",
    "elysia": "1.4.30",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
    "playwright": "1.62.1",
    "prisma": "7.10.1",
    "typescript": "~6.0.3"
  },
  "main": "mobile/index.ts"
}
